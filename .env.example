# Local voice MCP — no speech API key required.
VOICE_REFERENCE_FILE=/absolute/path/to/clean-reference.wav
VOICE_PYTHON=/absolute/path/GPTHUB/.voice-venv/bin/python
# VOICE_DEVICE=cpu
# VOICE_OUTPUT_DIR=/absolute/path/to/audio

# Optional legacy browser app only:
# OPENAI_API_KEY=
PORT=3000

# Optional private JSON mapping reaction cue names to absolute audio paths:
# VOICE_REACTIONS_FILE=/absolute/private/reactions.json
